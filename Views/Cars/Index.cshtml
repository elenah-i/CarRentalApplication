
@model List<CarRentalApplication.Models.Car>

@{
    ViewData["Title"] = "Available Cars";
}

<h2 class="mb-2">Available Cars</h2>

<p class="text-muted mb-4">
    Select a car to book it for your rental.
</p>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        No cars are currently available.
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var car in Model)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body d-flex flex-column p-4">

                        <div class="d-flex justify-content-between
                                    align-items-start mb-3">
                            <h5 class="card-title mb-0">
                                @car.Name
                            </h5>

                            <span class="badge bg-success">
                                Available
                            </span>
                        </div>

                        <p class="card-text fs-5 fw-semibold mb-4">
                            PKR @car.PricePerDay.ToString("N0")
                            <small class="text-muted fs-6">
                                / day
                            </small>
                        </p>

                        <form asp-controller="Cars"
                              asp-action="Book"
                              method="post"
                              class="mt-auto">

                            <input type="hidden"
                                   name="id"
                                   value="@car.Id" />

                            <button type="submit"
                                    class="btn btn-primary w-100">
                                Book Car
                            </button>
                        </form>

                    </div>
                </div>
            </div>
        }
    </div>
}
